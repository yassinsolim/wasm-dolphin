+// Resolves an effective address to a host base/offset when the whole access is
+// inside MEM1 or, on Wii, MEM2. Uses the same standard-BAT 0x3fffffff mask as
+// the original MEM1-only fast paths; MMIO, L1 and out-of-range accesses fail.
+bool ResolveFastRamAccess(Memory::MemoryManager& memory, u32 address, u32 bytes, u8** base,
+                          u32* offset)
+{
+  const u32 physical = address & 0x3fffffff;
+  u8* const ram = memory.GetRAM();
+  const u32 ram_size = memory.GetRamSizeReal();
+  if (ram != nullptr && physical < ram_size && ram_size - physical >= bytes)
+  {
+    *base = ram;
+    *offset = physical;
+    return true;
+  }
+
+  u8* const exram = memory.GetEXRAM();
+  const u32 exram_size = memory.GetExRamSizeReal();
+  const u32 exram_offset = physical - WII_MEM2_PHYSICAL_BASE;
+  if (exram != nullptr && exram_offset < exram_size && exram_size - exram_offset >= bytes)
+  {
+    *base = exram;
+    *offset = exram_offset;
+    return true;
+  }
+
+  return false;
+}
