@@ -64,6 +64,32 @@ static const u16 dpad_bitmasks[] = {Wiimote::PAD_UP, Wiimote::PAD_DOWN, Wiimote:
 static const u16 dpad_sideways_bitmasks[] = {Wiimote::PAD_RIGHT, Wiimote::PAD_LEFT, Wiimote::PAD_UP,
                                              Wiimote::PAD_DOWN};
 
+#ifdef __EMSCRIPTEN__
+// Browser input bridge (core/upstream/dolphin_web_discio.cpp). Bits 0-6 follow
+// button_bitmasks; bits 8-11 are up/down/left/right as the player holds the remote.
+extern "C" int DolphinWeb_GetWiimoteInput(int index);
+// 1 = sideways, 0 = upright, negative = use the controller setting.
+extern "C" int DolphinWeb_GetWiimoteSideways(int index);
+
+static void ApplyWebWiimoteInput(int index, bool sideways, u16* buttons)
+{
+  const int web = DolphinWeb_GetWiimoteInput(index);
+  if (web == 0)
+    return;
+  for (int i = 0; i < 7; ++i)
+  {
+    if (web & (1 << i))
+      *buttons |= button_bitmasks[i];
+  }
+  const u16* const dpad = sideways ? dpad_sideways_bitmasks : dpad_bitmasks;
+  for (int i = 0; i < 4; ++i)
+  {
+    if (web & (1 << (8 + i)))
+      *buttons |= dpad[i];
+  }
+}
+#endif
